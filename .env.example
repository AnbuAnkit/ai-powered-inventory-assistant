# Backend settings. Copy to .env and adjust as needed.

# Get an API key from Google AI Studio and keep it in this backend-only file.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-4-argon

# Legacy Ollama settings are ignored by the current Google integration.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b
# Optional: override the assistant persona.
# SYSTEM_PROMPT=You are a concise inventory analyst.

API_HOST=0.0.0.0
API_PORT=8000

# Sales workbook imported into SQLite when the API starts.
DATASET_PATH=datasets/excel_sales_dataset_600_rows.xlsx
DATABASE_PATH=datasets/sales.sqlite3

# Expo web dev server origin(s). "*" keeps physical devices working locally;
# tighten this before deploying.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,*

# How many past messages are forwarded to the model.
MAX_HISTORY_MESSAGES=24

# Seconds to wait for the model before failing the request.
LLM_TIMEOUT_SECONDS=180
