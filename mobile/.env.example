# Optional: the app auto-detects the API URL in local development
# (localhost on web/iOS simulator, Metro's LAN IP on a device, 10.0.2.2 on the
# Android emulator). Set this for builds and deployed backends.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Set these when building the Vercel web prototype.
# EXPO_PUBLIC_API_URL=https://your-public-backend.example
# EXPO_PUBLIC_EXPO_GO_URL=exp://your-active-expo-tunnel-url
